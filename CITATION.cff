date-released: "2026-08-15"
license: MIT
repository-code: "https://github.com/yzoe236/icpms-qc"
url: "https://github.com/yzoe236/icpms-qc"
keywords:
  - ICP-MS
  - ICP-OES
  - quality control
  - analytical chemistry
  - mass spectrometry
  - method validation
